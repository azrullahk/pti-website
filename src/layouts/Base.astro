---
import '../styles/global.css';
import { company } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'PT Papua Teknologi Informasi — Menghubungkan Papua, Membangun Masa Depan',
  description = 'PTI membangun sistem informasi, mengelola data, otomasi AI, dan pemasaran digital untuk instansi pemerintah dan perusahaan di Papua — dikerjakan talenta Papua.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  alternateName: 'PTI',
  url: company.url,
  logo: `${company.url}/icon-512.png`,
  email: company.email,
  slogan: company.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Kusuma Bangsa, Oyehe',
    addressLocality: 'Nabire',
    addressRegion: 'Papua Tengah',
    addressCountry: 'ID',
  },
};
---
<!doctype html>
<html lang="id" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0F1729" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/img/topo.svg" as="image" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.replace('no-js','js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Langsung ke konten</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
