<section class="talent soft pad" id="talenta">
  <div class="talent__in wrap">
    <div class="talent__copy reveal">
      <h2 class="h2">Mencetak talenta digital dari Tanah Papua</h2>
      <p class="lead">Setiap proyek kami juga menjadi ruang belajar. Talenta lokal dilatih coding, data, AI, dan pemasaran digital — lalu langsung terlibat di proyek nyata.</p>
      <a class="arrow" href="mailto:admin@pti-co.tech?subject=Program%20pelatihan%20PTI">Gabung program pelatihan <span aria-hidden="true">→</span></a>
    </div>
    <div class="talent__art reveal" style="--d:.1s">
      <svg viewBox="0 0 640 400" role="img" aria-label="Diagram: talenta lokal mengikuti pelatihan coding, data, AI, dan marketing, lalu terlibat di proyek nyata, menuju mitra dan karier">
        <g stroke="#AEBBCE" stroke-width="1.2" fill="none">
          <path class="link" d="M100 200 L240 90" /><path class="link" d="M100 200 L240 160" /><path class="link" d="M100 200 L240 240" /><path class="link" d="M100 200 L240 310" />
          <path class="link" d="M240 90 L400 200" /><path class="link" d="M240 160 L400 200" /><path class="link" d="M240 240 L400 200" /><path class="link" d="M240 310 L400 200" />
          <path class="link" d="M400 200 L550 130" /><path class="link" d="M400 200 L550 270" />
        </g>
        <g font-family="JetBrains Mono, monospace" font-size="13">
          <circle cx="100" cy="200" r="6" fill="#0F1729" /><text x="100" y="230" text-anchor="middle" fill="#0F1729">Talenta lokal</text>
          <circle cx="240" cy="90" r="5" fill="#1565C0" /><text x="254" y="95" fill="#344054">Coding</text>
          <circle cx="240" cy="160" r="5" fill="#1565C0" /><text x="254" y="165" fill="#344054">Data</text>
          <circle cx="240" cy="240" r="5" fill="#1565C0" /><text x="254" y="245" fill="#344054">AI</text>
          <circle cx="240" cy="310" r="5" fill="#1565C0" /><text x="254" y="315" fill="#344054">Marketing</text>
          <rect x="358" y="186" width="84" height="28" rx="14" fill="#0F1729" /><text x="400" y="205" text-anchor="middle" fill="#fff">Proyek</text>
