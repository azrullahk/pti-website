---
import { services } from '../data/site';
import Icon from './Icon.astro';
---
<section class="services soft pad" id="layanan">
  <div class="services__head reveal">
    <h2 class="h2">Ubah cara organisasi Anda bekerja</h2>
    <p class="lead">Enam layanan yang saling terhubung, untuk instansi pemerintah maupun bisnis swasta.</p>
  </div>

  <div class="tabs reveal" role="tablist" aria-label="Pilih layanan" data-tabs>
    {services.map((s, i) => (
      <button class="tab" type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
    ))}
  </div>

  <div class="panels wrap">
    {services.map((s, i) => (
      <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0} tabindex="0">
        <div class="panel__copy">
          <span class="eyebrow">{s.kicker}</span>
          <h3>{s.title}</h3>
          <p class="lead">{s.body}</p>
          <ul class="chips">
            {s.chips.map((c) => <li><Icon name="check" size={16} stroke="#1565C0" width={2.4} />{c}</li>)}
          </ul>
          <span class="kbli">{s.kbli}</span>
          <a class="arrow" href="mailto:admin@pti-co.tech">Konsultasikan kebutuhan Anda <span aria-hidden="true">→</span></a>
        </div>
        <div class="panel__art" aria-hidden="true">
          {s.id === 'ai' && (
            <div class="art art--ai">
              <div class="card art__doc"><Icon name="doc" size={22} stroke="#475467" /><span>Surat masuk — permohonan izin.pdf</span><span class="mono" style="font-size:12px;color:#667085">09:14</span></div>
              <div class="art__step"><Icon name="spark" size={18} stroke="#1565C0" width={1.8} />AI membaca &amp; mengekstrak isi dokumen</div>
              <dl class="card art__fields">
                <dt>Nomor surat</dt><dd class="mono">045/DPM-PTSP/X/2026</dd>
                <dt>Perihal</dt><dd>Permohonan izin usaha</dd>
                <dt>Disposisi</dt><dd>Kepala Bidang Perizinan</dd>
              </dl>
              <div class="art__done"><Icon name="check" size={16} stroke="#7FB2F0" width={2.4} />Diteruskan otomatis · 3 detik</div>
              <span class="art__note">Contoh alur otomasi</span>
            </div>
          )}
          {s.id === 'software' && (
            <div class="art" style="max-width:500px">
              <div class="code">
                <div><b>modul</b> absensi → timesheet</div>
                <div><b>modul</b> timesheet → payroll</div>
                <div><b>uji</b> bersama pengguna <i>✓ lulus</i></div>
                <div><b>rilis</b> produksi <i>v2.4</i></div>
              </div>
              <div class="card status"><span class="dot"></span>Sistem berjalan normal</div>
            </div>
          )}
          {s.id === 'data' && (
            <div class="art art--data">
              <ul>
                <li class="card">Data kepegawaian</li>
                <li class="card">Arsip perkara</li>
                <li class="card">Transaksi</li>
              </ul>
              <svg width="80" height="24" viewBox="0 0 80 24"><path class="route" d="M2 12h70" stroke="#1565C0" stroke-width="1.6" /><path d="M66 5l8 7-8 7" stroke="#1565C0" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
              <div class="db"><Icon name="db" size={46} stroke="#7FB2F0" width={1.3} /><span>Backup harian ✓</span></div>
            </div>
          )}
          {s.id === 'publikasi' && (
            <div class="art art--pub">
              <article><small>BERITA DAERAH</small><strong>Pengumuman layanan publik terbaru</strong></article>
              <article><small>INFORMASI PUBLIK</small><strong>Laporan kegiatan bulanan instansi</strong></article>
              <article><small>ARTIKEL</small><strong>Cerita dari Tanah Papua</strong></article>
            </div>
          )}
          {s.id === 'marketing' && (
            <div class="art art--mkt">
              <div class="mkt__top">
                <div><span style="font-size:14px;color:#475467">Kampanye klien · minggu pertama</span><span class="mkt__big">23 negara</span></div>
                <span class="mono" style="font-size:12px;color:#1565C0">dijangkau iklan</span>
              </div>
              <div class="bars">
                <span style="height:28%;background:#C9D9EF"></span><span style="height:42%;background:#A9C3E8"></span><span style="height:38%;background:#A9C3E8"></span><span style="height:62%;background:#6F9AD6"></span><span style="height:80%;background:#3A75C4"></span><span style="height:100%;background:#1565C0"></span>
              </div>
            </div>
          )}
          {s.id === 'sdm' && (
            <div class="art art--sdm">
              <strong style="font-size:17px;font-weight:500">Kelas coding — angkatan Nabire</strong>
              <div class="prog"><div>Dasar pemrograman<span>100%</span></div><i><b style="--w:100%;background:#0F1729"></b></i></div>
              <div class="prog"><div>Membangun website<span>70%</span></div><i><b style="--w:70%;background:#1565C0"></b></i></div>
              <div class="prog"><div>Proyek bersama mitra<span>35%</span></div><i><b style="--w:35%;background:#6F9AD6"></b></i></div>
              <span class="art__note">Ilustrasi alur program</span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
