---
---
<section class="hero" id="top" data-hero>
  <div class="hero__grid" data-grid aria-hidden="true"></div>
  <div class="hero__copy pad">
    <h1 class="intro" style="--d:.05s">Teknologi yang menghubungkan Papua dengan dunia</h1>
    <p class="hero__sub intro" style="--d:.18s">Sistem informasi, data, AI, dan pemasaran digital — dikerjakan talenta Papua.</p>
    <div class="hero__cta intro" style="--d:.3s">
      <a class="btn btn--primary" href="mailto:admin@pti-co.tech?subject=Diskusi%20proyek%20dengan%20PTI">Diskusikan proyek Anda</a>
      <a class="arrow" href="#layanan">Jelajahi layanan <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="hero__art intro" style="--d:.45s" role="img" aria-label="Peta topografi pegunungan tengah Papua dengan Puncak Carstensz, serta jalur jaringan dari kantor pusat PTI di Nabire ke Timika dan Jayapura">
    <img class="hero__topo" src="/img/topo.svg" alt="" width="1440" height="560" fetchpriority="high" decoding="async" />
    <svg viewBox="0 0 1440 560" preserveAspectRatio="xMinYMid slice" aria-hidden="true">
      <g stroke="#1565C0" stroke-width="1.6" fill="none">
        <path class="route" d="M250 190 C 300 300, 420 400, 470 468" />
        <path class="route" d="M250 190 C 520 60, 980 60, 1240 140" />
      </g>
      <path d="M505 312 l9 14 h-18 z" fill="#0F1729" />
      <g class="hero__label">
        <text x="528" y="318" font-size="13" font-weight="500" fill="#0F1729">Puncak Carstensz · 4.884 mdpl</text>
        <text x="528" y="336" font-size="11" fill="#667085">4°05′ LS  137°11′ BT</text>
      </g>
      <circle cx="250" cy="190" r="16" fill="none" stroke="#1565C0" stroke-width="1.5">
        <animate attributeName="r" values="8;26" dur="2.6s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.8;0" dur="2.6s" repeatCount="indefinite" />
      </circle>
      <circle cx="250" cy="190" r="7" fill="#1565C0" stroke="#fff" stroke-width="3" />
      <circle cx="470" cy="468" r="5" fill="#0F1729" stroke="#fff" stroke-width="2.5" />
      <circle cx="1240" cy="140" r="5" fill="#0F1729" stroke="#fff" stroke-width="2.5" />
      <g class="hero__label">
        <text x="270" y="186" font-size="13" font-weight="500" fill="#0F1729">Nabire</text>
        <text x="270" y="203" font-size="11" fill="#1565C0">Kantor pusat PTI</text>
        <text x="486" y="474" font-size="13" font-weight="500" fill="#0F1729">Timika</text>
        <text x="1256" y="146" font-size="13" font-weight="500" fill="#0F1729">Jayapura</text>
      </g>
    </svg>
  </div>
</section>
